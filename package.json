{
  "name": "hermesv2",
  "version": "2.0.0",
  "description": "Hermes v2 Universal AI Assistant & Automation Engine",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "hermes": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node src/index.js 'ทดสอบระบบการทำงานของ Hermes v2'",
    "chat": "node src/index.js",
    "tts": "node src/index.js tts",
    "models": "node src/index.js models",
    "py": "python3 src/main.py",
    "py:tts": "python3 src/main.py --tts",
    "py:models": "python3 src/main.py --models",
    "voice": "python3 hermes-agent/plugins/realtime_voice/web/server.py",
    "tunnel": "powershell -ExecutionPolicy Bypass -NoProfile -File scripts/run-tunnel.ps1",
    "tunnel:custom": "powershell -ExecutionPolicy Bypass -NoProfile -File scripts/run-custom-tunnel.ps1"
  },
  "keywords": [
    "hermes",
    "hermesv2",
    "ai-assistant",
    "9router",
    "maymint",
    "oracle"
  ],
  "author": "Boss (ratchanon2003) & Maymint",
  "license": "MIT"
}
