# ------------------------------------------------------------------------------
# 🌿 Hermes v2 Git Ignore Standards (Git Team Workflow)
# ------------------------------------------------------------------------------

# Environment variables & secrets (CRITICAL)
.env
.env*.local
*.pem
*.key

# Operating System Files
.DS_Store
Thumbs.db

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Logs & temporary files
*.log
logs/
tmp/
temp/
*.mp3
*.wav
*.ogg


# IDE specific cache (but keep team rules)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
